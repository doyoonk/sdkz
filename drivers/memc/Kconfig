config STM32N6_EXTRA_SRAM
	bool "STM32N6 AHB SRAM and video SRAM initialization"
	default y
	depends on SOC_SERIES_STM32N6X
	depends on DT_HAS_HU_STM32N6_EXTRA_SRAM_ENABLED
	depends on CLOCK_CONTROL
	help
	  Enable the clocks for AHBSRAM1/2 and VENCRAM. Release VENCRAM for
	  system use only when the VENC devicetree node is explicitly disabled.
	  Only controllers with an enabled memory child are initialized.

config STM32N6_SYSTEM_SRAM
	bool "STM32N6 CACHEAXI and VENCRAM system SRAM"
	default y if MCUBOOT
	depends on SOC_SERIES_STM32N6X
	depends on DT_HAS_ST_STM32N6_SYSTEM_SRAM_ENABLED
	help
	  Enable CACHEAXI RAM and release VENCRAM for system use without
	  erasing their contents. NPU, NPU cache and VENC must be disabled.
	  The bootloader must initialize these banks before loading or starting
	  an application that includes them in its primary RAM. Application
	  SYS_INIT callbacks run after stack and BSS accesses and cannot
	  provide cold-start support. The SDK supplies this initialization.

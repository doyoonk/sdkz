#include "stm32n6570_dk_app_common.dtsi"
#include <st/n6/stm32n6-dts.dtsi>

#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pwm/pwm_ifx_tcpwm.h>
#include <zephyr/dt-bindings/pwm/ra_pwm.h>
#include <zephyr/dt-bindings/pwm/stm32_pwm.h>

/delete-node/ &red_led_2;

/* The PSRAM driver registers all of &psram as SMH_REG_ATTR_EXTERNAL.
 * Reserve the last 2 MiB for static display buffers, excluding the final
 * cache line required by STM32N6 erratum ES0620, section 2.4.5.
 */
&psram {
	reg = <0x90000000 DT_SIZE_M(30)>;
};

&ltdc {
	ext-sdram = <&display_ram>;
};

/ {
	display_ram: memory@91e00000 {
		compatible = "zephyr,memory-region";
		reg = <0x91e00000 (DT_SIZE_M(2) - 32)>;
		zephyr,memory-region = "PSRAM_DISPLAY";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM)>;
	};

	chosen {
		zephyr,dtcm = &dtcm;
		zephyr,itcm = &itcm;
		micropy,console = &cdc_acm_uart1;
	};

	example_sensor: example-sensor {
		compatible = "zephyr,example-sensor";
		input-gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>;
	};

	blink_led: blink-led {
		compatible = "blink-gpio-led";
		led-gpios = <&gpioo 1 GPIO_ACTIVE_HIGH>;
		blink-period-ms = <1000>;
	};

	pwmleds: pwmleds {
		compatible = "pwm-leds";
		status = "okay";

		pwm_led_0: pwm_led_0 {
			status = "okay";
			pwms = <&pwm1 1 PWM_MSEC(2000) (PWM_POLARITY_NORMAL | STM32_PWM_COMPLEMENTARY)>;
		};
	};
	gpio_keys {
		compatible = "gpio-keys";

		tamp_button: tamp {
			label = "Tamp";
			gpios = <&gpioe 0 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_1>;
		};
		boot1_button: boot1 {
			label = "Boot1";
			gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_2>;
		};
	};
	aliases {
		die-temp0 = &die_temp;
		vbat0 = &vbat;
		/delete-property/ led1;
		pwm-led0 = &pwm_led_0;
		hup-uart = &cdc_acm_uart0;
		//watchdog0 = &iwdg;
	};
};

&die_temp {
	status = "okay";
};

&iwdg {
        status = "disabled";
};

&wwdg {
        status = "disabled";
};

/* One 32 KiB palloc region, backed by two independently clocked banks. */
&ahbsram {
	status = "okay";
};

&ahbsram1 {
	status = "okay";
};

&ahbsram2 {
	status = "okay";
};

/* Release the video encoder SRAM for palloc. */
&venc {
	status = "disabled";
};

&venc_ram {
	status = "okay";
};

&timers1 {
	status = "okay";
	st,countermode = <0x10>; /* downcounter */

	/delete-node/ pwm1;
	pwm1: pwm {
		status = "okay";
		pinctrl-0 = <&tim1_ch1_pe9 &tim1_ch1n_pg10>;
		pinctrl-names = "default";
	};
};

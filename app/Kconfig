# This file is the application Kconfig entry point. All application Kconfig
# options can be defined here or included via other application Kconfig files.
# You can browse these options using the west targets menuconfig (terminal) or
# guiconfig (GUI).

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"

config BOARD_HAS_VBAT_BATTERY
  bool
  default n
  prompt "Board has VBAT battery support"
  help
    Enable VBAT battery support if the board has a battery connected to
    the VBAT pin of the MCU. This allows the RTC and backup registers to
    retain their content when the main power supply is turned off.

config MICROPYTHON
  bool "Micropython"

config MICROPYTHON_THREAD_STACK_SIZE
  int
  default 4736
  help
    MicroPython thread stack size

mainmenu "Video capture to LVGL sample application"

menu "Video capture configuration"

config VIDEO_SOURCE_CROP_LEFT
	int "Crop area left value"
	default 0
	help
	   Left value of the crop area within the video source.

config VIDEO_SOURCE_CROP_TOP
	int "Crop area top value"
	default 0
	help
	   Top value of the crop area within the video source.

config VIDEO_SOURCE_CROP_WIDTH
	int "Crop area width value"
	default 0
	help
	   Width value of the crop area within the video source.
	   If set to 0, the crop is not applied.

config VIDEO_SOURCE_CROP_HEIGHT
	int "Crop area height value"
	default 0
	help
	   Height value of the crop area within the video source.
	   If set to 0, the crop is not applied.

config VIDEO_WIDTH
	int "Define the width of the video"
	default 320

config VIDEO_HEIGHT
	int "Define the height of the video"
	default 240

config VIDEO_HFLIP
	bool "Horizontal flip"
	default n

config APP_CAMERA_CAPTURE
	bool "HU camera snapshot transfer"
	depends on VIDEO && HU_PACKET
	help
	  Keep one native-format snapshot for chunked transfer to a PC over HU.
	  Reserves APP_CAMERA_FRAME_CAPACITY bytes for an unmodified snapshot.
	  Uses the video shared heap when enabled, otherwise the video memory
	  region or application RAM.

config APP_CAMERA_FRAME_CAPACITY
	int "Maximum bytes per camera frame"
	default 4194304 if SOC_SERIES_STM32N6X
	default 153600
	range 32 33554400
	help
	  Capacity of each DMA buffer and the snapshot buffer. Runtime formats
	  must fit this limit as well as the maximum width and height.

config APP_CAMERA_PIXEL_FORMAT
	string "Camera output pixel format"
	default "RGBP"
	help
	  Initial Zephyr FourCC (RGBP is RGB565). Any format advertised by the
	  camera driver can be selected using HU cam_config at runtime.

config APP_CAMERA_MAX_WIDTH
	int "Maximum runtime camera width"
	default 1920 if SOC_SERIES_STM32N6X
	default VIDEO_WIDTH
	range 1 4094

config APP_CAMERA_MAX_HEIGHT
	int "Maximum runtime camera height"
	default 1080 if SOC_SERIES_STM32N6X
	default VIDEO_HEIGHT
	range 1 4094

config VIDEO_VFLIP
	bool "Vertical flip"
	default n

endmenu

rsource "micropython/Kconfig"
